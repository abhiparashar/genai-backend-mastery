# Copy to .env and fill in. NEVER commit .env (see .gitignore).
#   cp .env.example .env
#
# Everything in this repo runs WITHOUT these keys using the built-in FakeProvider.
# Keys are only needed for the tests/examples marked `live`.

# --- LLM providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Optional extras
GOOGLE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# --- Defaults used by llmkit ---
LLM_PROVIDER=fake          # fake | openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Budget guardrail: hard stop so a runaway loop cannot drain your card ---
LLM_DAILY_BUDGET_USD=5.00

# --- Production service (06-production-service) ---
API_KEYS=dev-key-1,dev-key-2
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genai
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
